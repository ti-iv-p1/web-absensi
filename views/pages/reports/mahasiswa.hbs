<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Laporan Kehadiran Pribadi</h3>
        <p class="text-muted mb-0">
            <strong>{{data.mahasiswa.nama}}</strong> ({{data.mahasiswa.nim}}) —
            {{#eq data.mahasiswa.program_studi "ti"}}Teknik Informatika{{/eq}}
            {{#eq data.mahasiswa.program_studi "si"}}Sistem Informasi{{/eq}}
            {{#eq data.mahasiswa.program_studi "it"}}Information Technology{{/eq}}
            Angkatan {{data.mahasiswa.angkatan}}
        </p>
    </div>
</div>

{{!-- Ringkasan Global --}}
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm h-100 text-center py-3" style="border-left: 4px solid #198754 !important;">
            <div class="card-body">
                <h3 class="fw-bold text-success mb-1">{{data.ringkasanGlobal.total_hadir}}</h3>
                <small class="text-muted">Hadir</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm h-100 text-center py-3" style="border-left: 4px solid #0dcaf0 !important;">
            <div class="card-body">
                <h3 class="fw-bold text-info mb-1">{{data.ringkasanGlobal.total_izin}}</h3>
                <small class="text-muted">Izin</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm h-100 text-center py-3" style="border-left: 4px solid #fd7e14 !important;">
            <div class="card-body">
                <h3 class="fw-bold text-warning mb-1" style="color:#fd7e14;">{{data.ringkasanGlobal.total_sakit}}</h3>
                <small class="text-muted">Sakit</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm h-100 text-center py-3" style="border-left: 4px solid #dc3545 !important;">
            <div class="card-body">
                <h3 class="fw-bold text-danger mb-1">{{data.ringkasanGlobal.total_alpha}}</h3>
                <small class="text-muted">Alpha</small>
            </div>
        </div>
    </div>
</div>

{{!-- Progress Kehadiran --}}
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="fw-bold mb-0">📊 Progress Kehadiran Keseluruhan</h5>
    </div>
    <div class="card-body">
        {{#if (gt data.ringkasanGlobal.total_sesi 0)}}
        <div class="row align-items-center">
            <div class="col-md-10">
                <div class="progress" style="height: 25px;">
                    <div class="progress-bar bg-success" role="progressbar"
                        style="width: {{persentase data.ringkasanGlobal.total_hadir data.ringkasanGlobal.total_sesi}}%"
                        title="Hadir">
                        {{persentase data.ringkasanGlobal.total_hadir data.ringkasanGlobal.total_sesi}}% Hadir
                    </div>
                </div>
            </div>
            <div class="col-md-2 text-end">
                <span class="fw-bold">
                    {{data.ringkasanGlobal.total_hadir}}/{{data.ringkasanGlobal.total_sesi}} sesi
                </span>
            </div>
        </div>
        {{else}}
        <p class="text-muted mb-0 text-center">Belum ada data kehadiran</p>
        {{/if}}
    </div>
</div>

{{!-- Detail per Mata Kuliah --}}
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <h5 class="fw-bold mb-0">📚 Detail Kehadiran per Mata Kuliah</h5>
    </div>
    <div class="card-body p-0">
        {{#if data.perMataKuliah.length}}
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Kode MK</th>
                        <th>Mata Kuliah</th>
                        <th>Kelas</th>
                        <th>Dosen</th>
                        <th>SKS</th>
                        <th>Semester</th>
                        <th class="text-center text-success">H</th>
                        <th class="text-center text-info">I</th>
                        <th class="text-center text-warning">S</th>
                        <th class="text-center text-danger">A</th>
                        <th class="text-center">Total</th>
                        <th>% Hadir</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each data.perMataKuliah}}
                    <tr>
                        <td><span class="badge bg-secondary">{{kode_mata_kuliah}}</span></td>
                        <td>{{nama_mata_kuliah}}</td>
                        <td>{{nama_kelas}}</td>
                        <td>{{nama_dosen}}</td>
                        <td>{{sks}}</td>
                        <td>{{semester}} {{tahun_akademik}}</td>
                        <td class="text-center text-success fw-bold">{{total_hadir}}</td>
                        <td class="text-center text-info fw-bold">{{total_izin}}</td>
                        <td class="text-center text-warning fw-bold">{{total_sakit}}</td>
                        <td class="text-center text-danger fw-bold">{{total_alpha}}</td>
                        <td class="text-center fw-bold">{{total_sesi}}</td>
                        <td>
                            {{#if (gt total_sesi 0)}}
                            <div class="progress" style="height: 18px;">
                                <div class="progress-bar
                                    {{#if (gt (persentase total_hadir total_sesi) 75)}}bg-success{{/if}}
                                    {{#if (and (gt (persentase total_hadir total_sesi) 50) (lte (persentase total_hadir total_sesi) 75))}}bg-warning{{/if}}
                                    {{#if (lte (persentase total_hadir total_sesi) 50)}}bg-danger{{/if}}"
                                    role="progressbar"
                                    style="width: {{persentase total_hadir total_sesi}}%"
                                    aria-valuenow="{{total_hadir}}" aria-valuemin="0" aria-valuemax="{{total_sesi}}">
                                    {{persentase total_hadir total_sesi}}%
                                </div>
                            </div>
                            {{else}}
                            <small class="text-muted">-</small>
                            {{/if}}
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="text-center py-5 text-muted">
            <p class="mb-0">Belum terdaftar di kelas manapun</p>
        </div>
        {{/if}}
    </div>
</div>

{{!-- Riwayat Absensi Lengkap --}}
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="fw-bold mb-0">📋 Riwayat Absensi Lengkap</h5>
    </div>
    <div class="card-body p-0">
        {{#if data.riwayatLengkap.length}}
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tanggal</th>
                        <th>Mata Kuliah</th>
                        <th>Kelas</th>
                        <th>Pertemuan</th>
                        <th>Topik</th>
                        <th>Jam</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each data.riwayatLengkap}}
                    <tr>
                        <td>{{tanggal}}</td>
                        <td>{{nama_mata_kuliah}}</td>
                        <td>{{nama_kelas}}</td>
                        <td>Pertemuan {{pertemuan_ke}}</td>
                        <td>{{topik}}</td>
                        <td>{{jam_mulai}} - {{jam_selesai}}</td>
                        <td class="text-center">
                            {{#eq status "hadir"}}
                            <span class="badge bg-success">Hadir</span>
                            {{/eq}}
                            {{#eq status "izin"}}
                            <span class="badge bg-info">Izin</span>
                            {{/eq}}
                            {{#eq status "sakit"}}
                            <span class="badge bg-warning text-dark">Sakit</span>
                            {{/eq}}
                            {{#eq status "alpha"}}
                            <span class="badge bg-danger">Alpha</span>
                            {{/eq}}
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="text-center py-5 text-muted">
            <p class="mb-0">Belum ada riwayat absensi</p>
        </div>
        {{/if}}
    </div>
</div>
